{
  "key": "personal",
  "name": "To-dos",
  "icon": "☑",
  "color": "#0f766e",
  "version": "1.0.0",
  "hidden": true,
  "description": "Your own to-dos and bookmarks. Only you see them.",
  "tables": [
    {
      "key": "todos",
      "name": "To-dos",
      "icon": "☑",
      "display": "title",
      "fields": [
        {
          "key": "title",
          "name": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "done",
          "name": "Done",
          "type": "checkbox"
        },
        {
          "key": "due",
          "name": "Due",
          "type": "date"
        },
        {
          "key": "priority",
          "name": "Priority",
          "type": "select",
          "options": {
            "choices": [
              {
                "value": "Low",
                "color": "#e5e7eb"
              },
              {
                "value": "Normal",
                "color": "#dbeafe"
              },
              {
                "value": "High",
                "color": "#fed7aa"
              }
            ]
          }
        },
        {
          "key": "link",
          "name": "Link",
          "type": "url",
          "description": "e.g. the record it's about"
        },
        {
          "key": "notes",
          "name": "Notes",
          "type": "longtext"
        },
        {
          "key": "done_at",
          "name": "Done at",
          "type": "datetime",
          "options": {
            "readonly": true
          }
        },
        {
          "key": "created",
          "name": "Added",
          "type": "created_time"
        }
      ],
      "views": [
        {
          "name": "To do",
          "type": "grid",
          "config": {
            "fields": [
              "title",
              "done",
              "due",
              "priority",
              "link"
            ],
            "filters": {
              "match": "all",
              "rules": [
                {
                  "field": "done",
                  "op": "unchecked"
                }
              ]
            },
            "sorts": [
              {
                "field": "due",
                "dir": "asc"
              }
            ]
          }
        },
        {
          "name": "Calendar",
          "type": "calendar",
          "config": {
            "date_field": "due",
            "color_field": "priority"
          }
        },
        {
          "name": "All",
          "type": "grid"
        }
      ]
    },
    {
      "key": "bookmarks",
      "name": "Bookmarks",
      "icon": "🔖",
      "display": "title",
      "fields": [
        {
          "key": "title",
          "name": "Title",
          "type": "text",
          "required": true
        },
        {
          "key": "url",
          "name": "Address",
          "type": "url",
          "required": true
        },
        {
          "key": "note",
          "name": "Note",
          "type": "text"
        }
      ],
      "views": [
        {
          "name": "Bookmarks",
          "type": "grid"
        }
      ]
    }
  ],
  "automations": [
    {
      "key": "done_at",
      "table": "todos",
      "name": "Note when a to-do is done",
      "trigger": "record_updated",
      "trigger_config": {
        "fields": [
          "done"
        ]
      },
      "actions": [
        {
          "type": "update_record",
          "target": "this",
          "values": {
            "done_at": "=IF({Done}, NOW(), BLANK())"
          }
        }
      ]
    }
  ],
  "records": {
    "todos": [
      {
        "Title": "Read the tutorials",
        "Priority": "Normal",
        "Link": "/x/tutorials/"
      }
    ],
    "bookmarks": [
      {
        "Title": "Tutorials",
        "Address": "/x/tutorials/"
      }
    ]
  }
}
