      }
    ]
  },
  "after_records": [
    {
      "table": "orders",
      "find": {
        "Number": "PO-0001"
      },
      "press": [
        "place"
      ]
    },
    {
      "table": "orders",
      "find": {
        "Number": "PO-0002"
      },
      "press": [
        "place",
        "receive_all"
      ]
    }
  ]
}