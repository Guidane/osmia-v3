{
  "key": "harnesses",
  "name": "Harnesses",
  "icon": "🧵",
  "color": "#c2410c",
  "version": "4.0.0",
  "position": 42,
  "group": "Production",
  "description": "Wire harnesses: each harness's parts (connectors, contacts, wire, cable ties, ..., with how many) and its pinout, A contact to B contact between its connectors, the wires of a set (a twisted pair) kept together; its build time from a time per wire; and its builds, each with a harness ID and a checklist of every wire, placed and verified.",
  "requires": [
    "parts"
  ],
  "tables": [
    {
      "key": "harnesses",
      "name": "Harnesses",
      "icon": "🧵",
      "display": "name",
      "fields": [
        {
          "key": "name",
          "name": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "number",
          "name": "Number",
          "type": "autonumber",
          "options": {
            "prefix": "H-",
            "digits": 4
          }
        },
        {
          "key": "status",
          "name": "Status",
          "type": "select",
          "options": {
            "default": "Draft",
            "choices": [
              {
                "value": "Draft",
                "color": "#e5e7eb"
              },
              {
                "value": "Released",
                "color": "#bbf7d0"
              },
              {
                "value": "Obsolete",
                "color": "#fecaca"
              }
            ]
          }
        },
        {
          "key": "description",
          "name": "Description",
          "type": "text"
        },
        {
          "key": "wire_count",
          "name": "Wire count",
          "type": "rollup",
          "options": {
            "link": "wires",
            "func": "count"
          }
        },
        {
          "key": "time_per_wire",
          "name": "Time per wire (min)",
          "type": "number",
          "options": {
            "default": "3"
          },
          "description": "How long making one wire of the pinout takes, both ends and all."
        },
        {
          "key": "build_time",
          "name": "Build time (min)",
          "type": "formula",
          "options": {
            "expression": "{Time per wire (min)} * {Wire count}"
          },
          "description": "The time per wire, times every wire of the pinout."
        },
        {
          "key": "total_length",
          "name": "Wire length (mm)",
          "type": "rollup",
          "options": {
            "link": "wires",
            "field": "length",
            "func": "sum"
          }
        },
        {
          "key": "build",
          "name": "Build",
          "type": "button",
          "options": {
            "label": "Build harness",
            "color": "#c2410c",
            "automation": "build"
          }
        },
        {
          "key": "pictures",
          "name": "Pictures and drawings",
          "type": "attachment"
        },
        {
          "key": "notes",
          "name": "Notes",
          "type": "longtext"
        }
      ],
      "views": [
        {
          "name": "Harnesses",
          "type": "grid",
          "config": {
            "fields": [
              "number",
              "name",
              "status",
              "description",
              "wire_count",
              "build_time",
              "total_length"
            ]
          }
        }
      ]
    },
    {
      "key": "connectors",
      "name": "Harness parts",
      "icon": "📦",
      "display": "label",
      "fields": [
        {
          "key": "label",
          "name": "Harness part",
          "type": "formula",
          "options": {
            "expression": "IF(ISBLANK({Designator}), {Part}, {Designator} & IF(ISBLANK({Part}), \"\", \" · \" & {Part}) & IF(ISBLANK({Gender}), \"\", \" · \" & {Gender}))"
          }
        },
        {
          "key": "harness",
          "name": "Harness",
          "type": "link",
          "options": {
            "target": "harnesses",
            "multiple": false,
            "inverse": {
              "key": "connectors",
              "name": "Parts",
              "multiple": true,
              "show": {
                "fields": [
                  "part",
                  "quantity",
                  "unit",
                  "designator",
                  "side",
                  "gender"
                ],
                "sort": [
                  "designator"
                ],
                "link_existing": false,
                "add_by": "part",
                "add_quantity": "quantity"
              }
            }
          }
        },
        {
          "key": "part",
          "name": "Part",
          "type": "link",
          "options": {
            "target": "parts.parts",
            "multiple": false,
            "inverse": {
              "key": "harness_connectors",
              "name": "On harnesses",
              "multiple": true
            }
          },
          "required": true
        },
        {
          "key": "quantity",
          "name": "Quantity",
          "type": "number",
          "options": {
            "default": "1"
          },
          "description": "How many, in the part's unit (pieces, metres, ...)."
        },
        {
          "key": "unit",
          "name": "Unit",
          "type": "lookup",
          "options": {
            "link": "part",
            "field": "unit"
          }
        },
        {
          "key": "designator",
          "name": "Designator",
          "type": "text",
          "required": false,
          "description": "For a connector: its name on the harness, e.g. X1. The pinout wires between the parts that have one."
        },
        {
          "key": "side",
          "name": "Side",
          "type": "select",
          "options": {
            "choices": [
              {
                "value": "A",
                "color": "#dbeafe"
              },
              {
                "value": "B",
                "color": "#fde68a"
              }
            ]
          },
          "description": "For a connector: the side it is on."
        },
        {
          "key": "part_attributes",
          "name": "Part attributes",
          "type": "lookup",
          "options": {
            "link": "part",
            "field": "attributes"
          }
        },
        {
          "key": "gender",
          "name": "Gender",
          "type": "formula",
          "options": {
            "expression": "ATTRIBUTE({Part attributes}, \"Gender\")"
          },
          "description": "From the part's attributes."
        },
        {
          "key": "notes",
          "name": "Notes",
          "type": "text"
        }
      ],
      "views": [
        {
          "name": "Harness parts",
          "type": "grid",
          "config": {
            "group_by": "harness",
            "fields": [
              "part",
              "quantity",
              "unit",
              "designator",
              "side",
              "gender"
            ],
            "sorts": [
              {
                "field": "designator",
                "dir": "asc"
              }
            ]
          }
        }
      ]
    },
    {
      "key": "wires",
      "name": "Pinout",
