          }
        },
        {
          "key": "progress",
          "name": "Progress",
          "type": "formula",
          "options": {
            "expression": "IF({Wires} = 0, \"\", IF({Verified} = {Wires}, \"Done\", IF({Placed} = 0, \"Not started\", {Placed} & \" of \" & {Wires} & \" placed, \" & {Verified} & \" verified\")))"
