{
  "key": "parts",
  "name": "Parts",
  "icon": "📦",
  "color": "#0891b2",
  "version": "1.0.0",
  "position": 30,
  "description": "The parts catalogue: part numbers, nested categories, datasheets and pictures, which parts fit into which, and the tools to work with them.",
  "after": ["tools"],
  "tables": [
    {
      "key": "parts",
      "name": "Parts",
      "icon": "📦",
      "display": "part_number",
      "fields": [
        {"key": "part_number", "name": "Part number", "type": "text", "required": true},
        {"key": "description", "name": "Description", "type": "text"},
        {"key": "category", "name": "Category", "type": "link",
         "options": {"target": "categories", "multiple": false, "inverse": {"key": "parts", "name": "Parts", "multiple": true}}},
        {"key": "manufacturer", "name": "Manufacturer", "type": "text"},
        {"key": "mpn", "name": "Manufacturer part number", "type": "text"},
        {"key": "unit", "name": "Unit", "type": "select", "options": {"default": "pcs", "choices": [
          {"value": "pcs"}, {"value": "m"}, {"value": "kg"}, {"value": "set"}, {"value": "roll"}]}},
        {"key": "datasheet", "name": "Datasheet", "type": "url"},
        {"key": "attributes", "name": "Attributes", "type": "longtext", "description": "e.g. Resistance: 10 kΩ, one per line."},
        {"key": "accepts", "name": "Accepts", "type": "link", "description": "Parts that fit into this one, e.g. a housing's crimp contacts.",
         "options": {"target": "parts", "multiple": true, "inverse": {"key": "fits_into", "name": "Fits into", "multiple": true}}},
        {"key": "mates_with", "name": "Mates with", "type": "link", "description": "The other half, e.g. a plug's receptacle.",
         "options": {"target": "parts", "multiple": true, "inverse": {"key": "mated_by", "name": "Mated by", "multiple": true}}},
        {"key": "tools", "name": "Tools", "type": "link",
         "options": {"target": "tools.tools", "optional": true, "multiple": true, "inverse": {"key": "parts", "name": "Used with parts", "multiple": true}}},
        {"key": "pictures", "name": "Pictures and files", "type": "attachment"},
        {"key": "active", "name": "Active", "type": "checkbox", "options": {"default": "1"}}
      ],
      "views": [
        {"name": "Parts", "type": "grid", "config": {"fields": ["part_number", "description", "category", "manufacturer", "unit", "pictures", "active"],
          "sorts": [{"field": "part_number", "dir": "asc"}]}},
        {"name": "Catalogue", "type": "gallery", "config": {"cover_field": "pictures", "fields": ["part_number", "description", "category"]}},
        {"name": "By category", "type": "grid", "config": {"group_by": "category", "fields": ["part_number", "description", "manufacturer", "unit"]}}
      ]
    },
    {
      "key": "categories",
      "name": "Categories",
      "icon": "🗂",
      "display": "name",
      "fields": [
        {"key": "name", "name": "Name", "type": "text", "required": true},
        {"key": "parent", "name": "Part of", "type": "link",
         "options": {"target": "categories", "multiple": false, "inverse": {"key": "subcategories", "name": "Subcategories", "multiple": true}}},
        {"key": "part_count", "name": "Parts here", "type": "rollup", "options": {"link": "parts", "func": "count"}},
        {"key": "attribute_names", "name": "Attributes to fill in", "type": "longtext"}
      ],
      "views": [{"name": "Categories", "type": "tree", "config": {"parent_field": "parent", "fields": ["name", "part_count", "attribute_names"]}}]
    }
  ],
  "records": {
    "categories": [
      {"Name": "Passives"},
      {"Name": "Resistors", "Part of": "Passives", "Attributes to fill in": "Resistance\nPower\nTolerance"},
      {"Name": "Capacitors", "Part of": "Passives", "Attributes to fill in": "Capacitance\nVoltage"},
      {"Name": "Connectors"},
      {"Name": "D-sub", "Part of": "Connectors"},
      {"Name": "Contacts", "Part of": "Connectors"},
      {"Name": "Wire"}
    ],
    "parts": [
      {"Part number": "RES-10K-0603", "Description": "Resistor 10 kΩ 1% 0603", "Category": "Resistors", "Manufacturer": "Yageo", "Attributes": "Resistance: 10 kΩ\nPower: 0.1 W\nTolerance: 1%"},
      {"Part number": "CAP-100N-0603", "Description": "Capacitor 100 nF 50 V X7R 0603", "Category": "Capacitors", "Manufacturer": "Murata"},
      {"Part number": "DSUB-9-CONTACT", "Description": "D-sub crimp contact, male, 20-24 AWG", "Category": "Contacts", "Manufacturer": "TE", "Tools": ["D-sub crimp tool", "Contact extraction tool"]},
      {"Part number": "DSUB-9-PLUG", "Description": "D-sub 9 plug housing, crimp", "Category": "D-sub", "Manufacturer": "TE", "Accepts": ["DSUB-9-CONTACT"]},
      {"Part number": "DSUB-9-RECEPT", "Description": "D-sub 9 receptacle, panel mount", "Category": "D-sub", "Manufacturer": "TE", "Mates with": ["DSUB-9-PLUG"]},
      {"Part number": "WIRE-22-RED", "Description": "Hook-up wire 22 AWG red", "Category": "Wire", "Unit": "m"},
      {"Part number": "WIRE-22-BLK", "Description": "Hook-up wire 22 AWG black", "Category": "Wire", "Unit": "m"}
    ]
  }
}
