      "name": "Organisation",
      "icon": "🏢",
      "display": "name",
      "tree": "parent",
      "spaces": true,
      "fields": [
        {
          "key": "name",
          "name": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "kind",
          "name": "Kind",
          "type": "select",
          "options": {
            "default": "Team",
            "choices": [
              {
                "value": "Company",
                "color": "#e0e7ff"
              },
              {
                "value": "Department",
                "color": "#dbeafe"
              },
              {
                "value": "Team",
                "color": "#dcfce7"
              },
              {
                "value": "Role",
                "color": "#fef3c7"
              }
            ]
          }
        },
        {
          "key": "parent",
          "name": "Part of",
          "type": "link",
          "options": {
            "target": "departments",
            "multiple": false,
            "inverse": {
              "key": "sub_departments",
              "name": "Under it",
              "multiple": true
            }
          }
        },
        {
          "key": "person",
          "name": "Held by",
          "type": "user",
          "options": {
            "home": true
          },
          "description": "Who holds the role (for a role): it is a tab on their Home."
        },
        {
          "key": "manager",
          "name": "Manager",
          "type": "user"
        },
        {
          "key": "email",
          "name": "Email",
          "type": "email"
        },
        {
          "key": "notes",
          "name": "Notes",
          "type": "longtext"
        }
      ],
      "views": [
        {
          "name": "Organisation",
          "type": "tree",
          "config": {
            "parent_field": "parent",
            "fields": [
              "name",
              "kind",
              "manager",
              "person",
              "email"
            ]
          }
        },
        {
          "name": "All",
          "type": "grid"
        },
        {
          "name": "By kind",
          "type": "kanban",
          "config": {
            "group_field": "kind",
            "fields": [
              "name",
              "manager"
            ]
          }
        }
      ]
    }
  ],
