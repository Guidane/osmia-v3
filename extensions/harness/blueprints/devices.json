{
  "key": "devices",
  "name": "Devices",
  "icon": "🔌",
  "color": "#3b7dd8",
  "version": "1.0.0",
  "position": 45,
  "description": "Anything with connectors that takes part in an electrical setup: units we build, test equipment, power supplies, loads, meters, adapters. Each connector has numbered pins with tags, a signal and a cable set.",
  "after": ["parts", "assemblies"],
  "tables": [
    {
      "key": "devices",
      "name": "Devices",
      "icon": "🔌",
      "display": "name",
      "fields": [
        {"key": "name", "name": "Name", "type": "text", "required": true},
        {"key": "part_number", "name": "Part number", "type": "text"},
        {"key": "origin", "name": "Origin", "type": "select", "options": {"default": "Made by us", "choices": [
          {"value": "Made by us", "color": "#bbf7d0"}, {"value": "External", "color": "#e5e7eb"}]}},
        {"key": "role", "name": "Role", "type": "select", "options": {"default": "Product", "choices": [
          {"value": "Product", "color": "#bfdbfe"}, {"value": "Test equipment", "color": "#ddd6fe"}, {"value": "Power supply", "color": "#fecaca"},
          {"value": "Electronic load", "color": "#fed7aa"}, {"value": "Measurement", "color": "#fde68a"}, {"value": "Signal source", "color": "#a5f3fc"},
          {"value": "Interconnect", "color": "#e5e7eb"}, {"value": "Other"}]}},
        {"key": "assembly", "name": "Assembly", "type": "link",
         "options": {"target": "assemblies.assemblies", "optional": true, "multiple": false, "inverse": {"key": "devices", "name": "Devices", "multiple": true}}},
        {"key": "manufacturer", "name": "Manufacturer", "type": "text"},
        {"key": "model", "name": "Model number", "type": "text"},
        {"key": "asset_tag", "name": "Asset tag", "type": "text"},
        {"key": "color", "name": "Colour in the designer", "type": "color", "options": {"default": "#3b7dd8"}},
        {"key": "responsible", "name": "Responsible", "type": "user", "description": "Verifies the wiring to this device in harnesses."},
        {"key": "pictures", "name": "Pictures", "type": "attachment"},
        {"key": "notes", "name": "Notes", "type": "longtext"}
      ],
      "views": [
        {"name": "Devices", "type": "grid", "config": {"fields": ["name", "part_number", "origin", "role", "manufacturer", "responsible", "connector_count", "color"]}},
        {"name": "By role", "type": "kanban", "config": {"group_field": "role", "cover_field": "pictures", "fields": ["name", "part_number", "connector_count"]}},
        {"name": "Device pages", "type": "detail", "config": {"fields": ["name", "role", "part_number"]}}
      ]
    },
    {
      "key": "connectors",
      "name": "Connectors",
      "icon": "🔲",
      "display": "label",
      "fields": [
        {"key": "label", "name": "Connector", "type": "formula", "options": {"format": "text", "expression": "{Device} & \" \" & {Designator}"}},
        {"key": "device", "name": "Device", "type": "link", "required": true,
         "options": {"target": "devices", "multiple": false, "inverse": {"key": "connectors", "name": "Connectors", "multiple": true}}},
        {"key": "designator", "name": "Designator", "type": "text", "required": true, "description": "e.g. J01 (jack on the device) or P01 (plug)."},
        {"key": "side", "name": "Side", "type": "select", "options": {"default": "right", "choices": [{"value": "left"}, {"value": "right"}]},
         "description": "Where it sits in the harness designer."},
        {"key": "function", "name": "Function", "type": "text", "description": "What it's for, e.g. Main power in."},
        {"key": "part", "name": "Part", "type": "link",
         "options": {"target": "parts.parts", "optional": true, "multiple": false, "inverse": {"key": "connectors", "name": "Used as connector", "multiple": true}}},
        {"key": "tag_columns", "name": "Tag columns", "type": "number", "options": {"default": "1", "min": 1, "max": 4}},
        {"key": "position", "name": "Position", "type": "number"},
        {"key": "pinout", "name": "Pinout pictures", "type": "attachment"},
        {"key": "clone", "name": "Clone", "type": "button", "options": {"label": "Clone with its pins", "automation": "clone_connector"}}
      ],
      "views": [{"name": "Connectors", "type": "grid", "config": {"group_by": "device", "fields": ["designator", "device", "side", "function", "part", "pin_count", "tag_columns"]}}]
    },
    {
      "key": "pins",
      "name": "Pins",
      "icon": "•",
      "display": "label_full",
      "fields": [
        {"key": "label_full", "name": "Pin", "type": "formula", "options": {"format": "text", "expression": "{Connector} & \" pin \" & {Label}"}},
        {"key": "connector", "name": "Connector", "type": "link", "required": true,
         "options": {"target": "connectors", "multiple": false, "inverse": {"key": "pins", "name": "Pins", "multiple": true}}},
        {"key": "position", "name": "Position", "type": "number"},
        {"key": "label", "name": "Label", "type": "text", "description": "The number printed on the connector, e.g. 13."},
        {"key": "tag1", "name": "Tag 1", "type": "text"},
        {"key": "tag2", "name": "Tag 2", "type": "text"},
        {"key": "tag3", "name": "Tag 3", "type": "text"},
        {"key": "tag4", "name": "Tag 4", "type": "text"},
        {"key": "signal", "name": "Signal", "type": "link",
         "options": {"target": "signals", "multiple": false, "inverse": {"key": "pins", "name": "Pins", "multiple": true}}},
        {"key": "set", "name": "Set", "type": "number", "description": "Pins of one cable set share a number."},
        {"key": "set_type", "name": "Set type", "type": "select", "options": {"choices": [
          {"value": "Straight"}, {"value": "Twisted"}, {"value": "Shielded"}, {"value": "Twisted shielded"}]}}
      ],
      "views": [{"name": "Pins", "type": "grid", "config": {"group_by": "connector", "fields": ["connector", "position", "label", "tag1", "tag2", "signal", "set", "set_type"],
        "sorts": [{"field": "position", "dir": "asc"}]}}]
    },
    {
      "key": "signals",
      "name": "Signals",
      "icon": "〰",
      "display": "name",
      "fields": [
        {"key": "name", "name": "Name", "type": "text", "required": true},
        {"key": "description", "name": "Description", "type": "text"}
      ],
      "views": [{"name": "Signals", "type": "grid", "config": {"sorts": [{"field": "name", "dir": "asc"}]}}]
    },
    {
      "key": "pin_maps",
      "name": "Pin maps",
      "icon": "↔",
      "display": "label",
      "fields": [
        {"key": "label", "name": "Mapping", "type": "formula", "options": {"format": "text", "expression": "{From pin} & \" → \" & {To pin}"}},
        {"key": "device", "name": "Device", "type": "link",
         "options": {"target": "devices", "multiple": false, "inverse": {"key": "pin_maps", "name": "Pin map", "multiple": true}}},
        {"key": "from_pin", "name": "From pin", "type": "link", "required": true,
         "options": {"target": "pins", "multiple": false, "inverse": {"key": "maps_out", "name": "Passes to", "multiple": true}}},
        {"key": "to_pin", "name": "To pin", "type": "link", "required": true,
         "options": {"target": "pins", "multiple": false, "inverse": {"key": "maps_in", "name": "Comes from", "multiple": true}}}
      ],
      "views": [{"name": "Pin maps", "type": "grid", "config": {"group_by": "device"}}]
    }
  ],
  "extend": [
    {"table": "devices", "fields": [
      {"key": "connector_count", "name": "Connector count", "type": "rollup", "options": {"link": "connectors", "func": "count"}}
    ]},
    {"table": "connectors", "fields": [
      {"key": "pin_count", "name": "Pin count", "type": "rollup", "options": {"link": "pins", "func": "count"}}
    ]}
  ],
  "automations": [
    {"key": "number_pins", "table": "pins", "name": "Number new pins",
     "trigger": "record_created", "conditions": {"match": "all", "rules": [{"field": "position", "op": "is_empty"}]},
     "actions": [{"type": "update_record", "target": "this", "values": {"position": "={Connector.Pin count}", "label": "=IF(ISBLANK({Label}), {Connector.Pin count}, {Label})"}}]},
    {"key": "next_designator", "table": "connectors", "name": "Place new connectors last",
     "trigger": "record_created", "conditions": {"match": "all", "rules": [{"field": "position", "op": "is_empty"}]},
     "actions": [{"type": "update_record", "target": "this", "values": {"position": "={Device.Connector count}"}}]},
    {"key": "clone_connector", "table": "connectors", "name": "Clone a connector with its pins", "trigger": "button",
     "actions": [
       {"type": "create_record", "table": "connectors", "save_as": "copy", "values": {"device": "={Device}", "designator": "{Designator} copy",
         "side": "={Side}", "function": "={Function}", "part": "=IFERROR({Part}, BLANK())", "tag_columns": "={Tag columns}"}},
       {"type": "create_record", "table": "pins", "for_each": "pins", "values": {"connector": "={copy}", "position": "={item.Position}", "label": "={item.Label}",
         "tag1": "={item.Tag 1}", "tag2": "={item.Tag 2}", "tag3": "={item.Tag 3}", "tag4": "={item.Tag 4}", "signal": "={item.Signal}",
         "set": "={item.Set}", "set_type": "={item.Set type}"}}]},
    {"key": "unique_designator", "table": "connectors", "name": "One designator per device",
     "trigger": "record_created_or_updated", "trigger_config": {"fields": ["designator", "device"]},
     "conditions": {"match": "all", "rules": [], "formula": "COUNTA({Device.Connectors}) > COUNTA(UNIQUE({Device.Connectors.Designator}))"},
     "actions": [{"type": "block", "message": "{Device} already has a connector {Designator}."}]}
  ],
  "records": {
    "signals": [
      {"Name": "GND"}, {"Name": "PWR"}, {"Name": "+24V"}, {"Name": "+5V"}, {"Name": "TxP"}, {"Name": "TxN"}, {"Name": "RxP"}, {"Name": "RxN"},
      {"Name": "CAN_H"}, {"Name": "CAN_L"}, {"Name": "RS485_A"}, {"Name": "RS485_B"}, {"Name": "SDA"}, {"Name": "SCL"}, {"Name": "SENSE+"}, {"Name": "SENSE-"}
    ],
    "devices": [
      {"Name": "Controller unit", "Part number": "CU-100", "Origin": "Made by us", "Role": "Product", "Colour in the designer": "#3b7dd8", "Responsible": "alice"},
      {"Name": "Bench power supply", "Origin": "External", "Role": "Power supply", "Manufacturer": "Keysight", "Model number": "E36313A", "Colour in the designer": "#c62828"},
      {"Name": "CAN test box", "Origin": "Made by us", "Role": "Test equipment", "Colour in the designer": "#7c3aed", "Responsible": "alice"}
    ],
    "connectors": [
      {"Device": "Controller unit", "Designator": "J01", "Side": "left", "Function": "Power in", "Tag columns": 1},
      {"Device": "Controller unit", "Designator": "J02", "Side": "right", "Function": "CAN bus", "Part": "DSUB-9-RECEPT", "Tag columns": 2},
      {"Device": "Bench power supply", "Designator": "J01", "Side": "right", "Function": "Output 1"},
      {"Device": "CAN test box", "Designator": "J01", "Side": "left", "Function": "CAN in", "Part": "DSUB-9-RECEPT", "Tag columns": 2}
    ],
    "pins": [
      {"Connector": "Controller unit J01", "Label": "1", "Signal": "+24V", "Tag 1": "PWR_IN"},
      {"Connector": "Controller unit J01", "Label": "2", "Signal": "GND", "Tag 1": "PWR_RTN"},
      {"Connector": "Controller unit J02", "Label": "2", "Signal": "CAN_L", "Tag 1": "CAN1", "Set": 1, "Set type": "Twisted"},
      {"Connector": "Controller unit J02", "Label": "3", "Signal": "GND", "Tag 1": "CAN1"},
      {"Connector": "Controller unit J02", "Label": "7", "Signal": "CAN_H", "Tag 1": "CAN1", "Set": 1, "Set type": "Twisted"},
      {"Connector": "Bench power supply J01", "Label": "+", "Signal": "+24V"},
      {"Connector": "Bench power supply J01", "Label": "-", "Signal": "GND"},
      {"Connector": "CAN test box J01", "Label": "2", "Signal": "CAN_L", "Set": 1, "Set type": "Twisted"},
      {"Connector": "CAN test box J01", "Label": "3", "Signal": "GND"},
      {"Connector": "CAN test box J01", "Label": "7", "Signal": "CAN_H", "Set": 1, "Set type": "Twisted"}
    ]
  }
}
